# Local development only. Copy this file to .env and replace these values.
# Do not commit .env or real credentials.
ORACLE_PASSWORD=ChangeThisOraclePassword2026
APP_USER=ERP_APP
APP_USER_PASSWORD=ChangeThisAppPassword2026

# Symfony local development secret (replace for real deployments).
APP_SECRET=local-development-secret-change-me

# Internal Docker Compose service addresses (development).
REDIS_HOST=redis
REDIS_PORT=6379
ELASTICSEARCH_URL=http://elasticsearch:9200

# RabbitMQ local development credentials. Change before deployment.
RABBITMQ_USER=erp_app
RABBITMQ_PASSWORD=ChangeThisRabbitPassword2026
RABBITMQ_VHOST=/erp

# Generate a unique key with: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# Keep the real value only in .env or a secret manager; never commit it.
SUPPLIER_BANK_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
SUPPLIER_BANK_ENCRYPTION_KEY_VERSION=v1
