# Local development only. Copy this file to .env and replace these values.
# Do not commit .env or real credentials.
ORACLE_PASSWORD=ChangeThisOraclePassword2026
APP_USER=ERP_APP
APP_USER_PASSWORD=ChangeThisAppPassword2026

# Symfony local development secret (replace for real deployments).
APP_SECRET=local-development-secret-change-me

# Internal Docker Compose service addresses (development).
REDIS_HOST=redis
REDIS_PORT=6379
ELASTICSEARCH_URL=http://elasticsearch:9200

# RabbitMQ local development credentials. Change before deployment.
RABBITMQ_USER=erp_app
RABBITMQ_PASSWORD=ChangeThisRabbitPassword2026
RABBITMQ_VHOST=/erp

# Generate a unique key with: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# Keep the real value only in .env or a secret manager; never commit it.
SUPPLIER_BANK_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY= # local development only; replace with a unique secret
SUPPLIER_BANK_ENCRYPTION_KEY_VERSION=v1
# JSON map of old key versions to base64 keys; keep empty until rotating from an older key.
SUPPLIER_BANK_PREVIOUS_ENCRYPTION_KEYS='{}'

# Keycloak local development identity provider.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=ChangeThisKeycloakPassword2026
KEYCLOAK_ISSUER=http://localhost:8081/realms/erp-procurement
KEYCLOAK_AUDIENCE=erp-procurement-api
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/erp-procurement/protocol/openid-connect/certs

# Grafana local admin credentials. Change the password before exposing Grafana.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeThisGrafanaPassword2026
