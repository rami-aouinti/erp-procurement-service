{
  "name": "rami-aouinti/erp-procurement-backend",
  "description": "Symfony backend for the ERP procurement and inventory learning project",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "ext-oci8": "*",
    "doctrine/doctrine-bundle": "^3.4",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/orm": "^3.8",
    "symfony/console": "7.4.*",
    "symfony/dotenv": "7.4.*",
    "symfony/flex": "^2.6",
    "symfony/framework-bundle": "7.4.*",
    "symfony/runtime": "7.4.*",
    "symfony/yaml": "7.4.*"
  },
  "require-dev": {
    "symfony/phpunit-bridge": "^7.4"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/simple-phpunit --testsuite='Default'",
    "test:unit": "vendor/bin/simple-phpunit --testsuite='Supplier Unit'",
    "test:functional": "vendor/bin/simple-phpunit --testsuite='Supplier Functional'",
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ],
    "test:integration": "vendor/bin/simple-phpunit --testsuite='Supplier Integration'",
    "test:configuration": "vendor/bin/simple-phpunit --testsuite='Configuration Unit'"
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true,
      "php-http/discovery": true,
      "symfony/runtime": true
    },
    "sort-packages": true
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "7.4.*"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
