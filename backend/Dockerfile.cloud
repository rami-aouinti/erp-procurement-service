FROM php:8.4-fpm

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

ARG ORACLE_IC_VERSION=23.9.0.25.07
ARG ORACLE_IC_DIR=instantclient_23_9

WORKDIR /app

RUN apt-get update \
    && (apt-get install -y --no-install-recommends libaio1t64 || apt-get install -y --no-install-recommends libaio1) \
    && if [ -e /usr/lib/x86_64-linux-gnu/libaio.so.1t64 ] && [ ! -e /usr/lib/x86_64-linux-gnu/libaio.so.1 ]; then ln -s /usr/lib/x86_64-linux-gnu/libaio.so.1t64 /usr/lib/x86_64-linux-gnu/libaio.so.1; fi \
    && apt-get install -y --no-install-recommends curl unzip librabbitmq-dev nginx supervisor ${PHPIZE_DEPS} \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/oracle \
    && curl -fsSL "https://download.oracle.com/otn_software/linux/instantclient/2390000/instantclient-basiclite-linux.x64-${ORACLE_IC_VERSION}.zip" -o /tmp/instantclient-basic.zip \
    && curl -fsSL "https://download.oracle.com/otn_software/linux/instantclient/2390000/instantclient-sdk-linux.x64-${ORACLE_IC_VERSION}.zip" -o /tmp/instantclient-sdk.zip \
    && unzip -q /tmp/instantclient-basic.zip -d /opt/oracle \
    && unzip -qo /tmp/instantclient-sdk.zip -d /opt/oracle \
    && ln -s "/opt/oracle/${ORACLE_IC_DIR}" /opt/oracle/instantclient \
    && echo "/opt/oracle/instantclient" > /etc/ld.so.conf.d/oracle-instantclient.conf \
    && ldconfig \
    && printf "instantclient,/opt/oracle/instantclient\\n" | pecl install oci8 \
    && pecl install redis \
    && pecl install amqp \
    && docker-php-ext-enable oci8 redis amqp \
    && rm -f /tmp/instantclient-basic.zip /tmp/instantclient-sdk.zip

RUN docker-php-ext-install opcache \
    && sed -i 's/^listen = 9000/listen = 127.0.0.1:9000/' /usr/local/etc/php-fpm.d/zz-docker.conf \
    && printf '\\npid = /tmp/php-fpm.pid\\n' >> /usr/local/etc/php-fpm.conf \
    && apt-get purge -y --auto-remove curl ${PHPIZE_DEPS} \
    && rm -rf /var/lib/apt/lists/*

COPY docker/nginx.conf /etc/nginx/nginx.conf
COPY docker/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --prefer-dist --no-progress --no-scripts --classmap-authoritative

COPY . .
RUN composer dump-autoload --no-dev --classmap-authoritative \
    && mkdir -p var/cache var/log /tmp/nginx/client_temp /tmp/nginx/proxy_temp /tmp/nginx/fastcgi_temp /tmp/nginx/uwsgi_temp /tmp/nginx/scgi_temp \
    && chown -R www-data:www-data var /tmp/nginx

ENV APP_ENV=prod APP_DEBUG=0
USER www-data

EXPOSE 8000
CMD ["/usr/bin/supervisord", "-n", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
